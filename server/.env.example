# Your provider's M3U playlist URL (required)
M3U_URL=
# XMLTV EPG URL (optional; otherwise taken from the playlist's url-tvg header)
EPG_URL=
PORT=8787
DATA_DIR=./data
# Letterboxd username (public watchlist is synced and prioritized)
LETTERBOXD_USER=
# TMDB API key or read-access token (optional; can also be set in the app's Settings)
TMDB_API_KEY=
